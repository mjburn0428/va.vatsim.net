name: Publish website preview

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - 'nginx/**'
      - '.github/workflows/pages.yml'

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: github-pages
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Checkout
        uses: actions/checkout@v6
      - name: Configure Pages
        uses: actions/configure-pages@v5
      - name: Prepare public website
        shell: python
        run: |
          import os
          import shutil
          from pathlib import Path

          source = Path('nginx')
          output = Path(os.environ['RUNNER_TEMP']) / 'va-pages'
          output.mkdir()
          for entry in source.iterdir():
              if entry.is_file() and entry.suffix in {'.html', '.css', '.js', '.ico', '.csv'}:
                  shutil.copy2(entry, output / entry.name)
          for directory in ('flask-static', 'va-portal'):
              shutil.copytree(source / directory, output / directory)
          # Home links must stay within the GitHub Pages repository URL.
          for page in output.glob('*.html'):
              html = page.read_text(encoding='utf-8')
              page.write_text(html.replace('href="/"', 'href="./index.html"'), encoding='utf-8')
          (output / '.nojekyll').touch()
          assert (output / 'index.html').is_file()
          assert (output / 'main.css').is_file()
      - name: Upload website
        uses: actions/upload-pages-artifact@v4
        with:
          path: ${{ runner.temp }}/va-pages
      - name: Deploy website
        id: deployment
        uses: actions/deploy-pages@v4
